{
  "$id": "https://example.invalid/px4-planner/verification-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "candidate_trajectory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "hard": {
            "type": "boolean"
          },
          "margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "requirement_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "units": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "requirement_id",
          "status",
          "hard",
          "margin",
          "units",
          "detail"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "verifier_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "verifier_version",
    "candidate_trajectory_sha256",
    "accepted",
    "checks"
  ],
  "title": "VerificationReport v1",
  "type": "object"
}
